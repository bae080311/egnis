# 카페24 테스트몰 배포 자동화(scripts/cafe24-deploy.js)용 설정.
# 이 파일을 .env로 복사한 뒤 실제 값을 채운다. .env는 .gitignore에 등록되어 있어
# 절대 커밋되지 않는다 — 어떤 경우에도 실제 값을 이 .env.example 파일이나
# 다른 커밋 대상 파일에 직접 적지 말 것.
#
# 반드시 "테스트몰" 계정만 사용한다 (하드 룰: 운영몰 작업 금지).

# https://{여기값}.cafe24.com 의 서브도메인 부분
CAFE24_MALL_ID=

# 테스트몰 관리자 로그인 ID
CAFE24_ADMIN_ID=

# 테스트몰 관리자 로그인 비밀번호
CAFE24_ADMIN_PW=
